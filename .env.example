# LiveKit Cloud — Settings → Keys
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
LIVEKIT_ROOM=islaprime

# The Isle Evrima — RCON (NUNCA subir a git)
# En el VPS usa 127.0.0.1
ISLE_RCON_HOST=127.0.0.1
ISLE_RCON_PORT=8888
ISLE_RCON_PASSWORD=cambia-esta-password
ISLE_RCON_TIMEOUT_MS=5000

# Comandos RCON custom (plantillas). Placeholders: {steamId} {species} {skinId} {rewardId}
ISLE_RCON_APPLY_SKIN_CMD=ApplySkin {steamId} {species} {skinId}
ISLE_RCON_CLAIM_REWARD_CMD=GiveReward {steamId} {rewardId}

# Auth / sesión
AUTH_SECRET=genera-un-secreto-largo-aleatorio
NEXT_PUBLIC_SITE_URL=https://islaprime.lat
STEAM_API_KEY=
STEAM_REALM=https://islaprime.lat
STEAM_RETURN_URL=https://islaprime.lat/api/auth/steam/callback

# SQLite (ruta relativa a /prisma)
DATABASE_URL="file:./data/islaprime.db"

# Patreon webhook
PATREON_WEBHOOK_SECRET=
# Opcional JSON: {"supporter":{"coins":500,"marks":10,"label":"Supporter"}}
PATREON_TIER_MAP=

PORT=3000
HOSTNAME=0.0.0.0
